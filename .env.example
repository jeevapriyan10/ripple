# Display name used in API documentation and service metadata.
APP_NAME=ripple
# Runtime environment: development, staging, or production.
APP_ENV=development
# Python logging threshold for the backend.
LOG_LEVEL=INFO
# Interface on which the backend listens inside its container.
API_HOST=0.0.0.0
# TCP port on which the backend listens and is published locally.
API_PORT=8000
# Browser origins allowed to call the backend, as a comma-separated list.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public API path used by the frontend; nginx/Vite proxies this path to the backend.
VITE_API_BASE_URL=/api
