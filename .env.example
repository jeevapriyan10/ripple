# ==============================================================================
# Ripple Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Application display name used in API metadata and logging
APP_NAME=ripple

# Application deployment environment (must be one of: development, staging, production)
APP_ENV=development

# Logging verbosity level (options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Network interface IP address for the backend HTTP server to bind to
API_HOST=0.0.0.0

# Port number for the backend HTTP server to listen on
API_PORT=8000

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Base URL used by the frontend to reach the backend API (empty string uses current origin / reverse proxy)
VITE_API_BASE_URL=http://localhost:8000

# Comma-separated list of enabled payment network IDs to load (universal, upi, card, crypto, swift, wallet), or "all" to load all available adapters
ENABLED_NETWORKS=all

# Secret HMAC-SHA256 key for Card PAN tokenization (minimum 32 chars).
# MUST NEVER be committed to version control.
# In development, a fallback dev key is used if unset. In staging/production, this key is required.
# Generate a new key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CARD_PAN_TOKEN_KEY=generate_with_python_secrets_token_urlsafe_48

# Enable dry-run normalization endpoint POST /api/v1/networks/{network_id}/normalize
# Defaults to true in development, false in staging/production.
ENABLE_ADAPTER_DRY_RUN=true
